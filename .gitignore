# n8n REST API credentials — never commit
.env

# Legacy: an earlier plan considered using the n8n-mcp MCP server, which would
# have lived in .mcp.json. We switched to direct REST API calls; if anyone
# later resurrects the MCP path, the file is still gitignored.
.mcp.json

# Per-refresh cache of full workflow JSON (potentially MBs per workflow).
# Regenerated on every refresh; never the source of truth.
vault/_cache/

# macOS noise
.DS_Store

# Per-machine Claude Code permission overrides (shared config -> .claude/settings.json)
.claude/settings.local.json

# Per-user Obsidian UI state (open panes, cursor, layout) — churns constantly.
# The rest of .obsidian/ (plugins, appearance) is kept so the vault opens consistently.
vault/.obsidian/workspace.json
