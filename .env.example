# n8n REST API auth — used by scripts/n8n-api.sh and the sync runbooks
# under agent-os/standards/sync/. Copy this file to .env (gitignored) and fill
# in real values. Working values for the OLD instance are also mirrored in
# ../n8n_claude/.mcp.json (used as a v1 fallback only).
#
# Two instances are supported, selected by alias on the wrapper command line:
#   scripts/n8n-api.sh v1 /api/v1/workflows      # Old n8n instance
#   scripts/n8n-api.sh v2 /api/v1/workflows      # New n8n instance
# The agent only ever passes the alias (v1/v2) — never these URLs/keys — so
# secrets stay out of the command line and transcript.

# --- v1: Old n8n instance ---
N8N_API_URL_V1=https://old-instance.example.com
N8N_API_KEY_V1=your-v1-api-key-here

# --- v2: New n8n instance ---
N8N_API_URL_V2=https://new-instance.example.com
N8N_API_KEY_V2=your-v2-api-key-here

# Legacy single-instance names (optional): if the V1 vars above are unset, the
# wrapper falls back to these for v1 only.
# N8N_API_URL=https://old-instance.example.com
# N8N_API_KEY=your-api-key-here
